{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "noUnusedTemplateLiteral": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/*.{js,mjs,cjs,css,json,md}", "!dist", "!assets/web-vitals.js"]
  }
}
