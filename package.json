{
  "name": "rizafahmi.com",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Personal site rizafahmi.com",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist/",
    "prestart": "pnpm run clean",
    "start": "ELEVENTY_ENV=dev eleventy --serve",
    "prebuild": "pnpm run clean",
    "build": "ELEVENTY_ENV=prod eleventy && pagefind --site dist && pnpm run audit:site",
    "build:prod": "pnpm run build",
    "debug": "DEBUG=* eleventy",
    "images:optimize": "node scripts/optimize-images.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "og:default": "node scripts/generate-default-og.mjs",
    "og:force": "OG_IMAGE_FORCE=1 pnpm run build",
    "test": "node --test test/*.test.js",
    "new:catatan": "node scripts/new-catatan.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check": "biome check . && pnpm test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizafahmi/rizafahmi.com.git"
  },
  "keywords": [],
  "author": "Riza Fahmi <rizafahmi@gmail.com> (https://rizafahmi.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rizafahmi/rizafahmi.com/issues"
  },
  "homepage": "https://github.com/rizafahmi/rizafahmi.com#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@biomejs/biome": "^2.4.16",
    "@fontsource/schibsted-grotesk": "^5.2.8",
    "@fontsource/unbounded": "^5.2.8",
    "@shikijs/transformers": "^3.22.0",
    "husky": "^9.1.7",
    "nunjucks": "3.2.4",
    "pagefind": "^1.4.0",
    "rimraf": "5.0.5",
    "sharp": "^0.35.3",
    "shiki": "1.23.1"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^7.0.0"
  }
}
