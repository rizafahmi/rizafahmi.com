<script type="module" src="/assets/prompts.js?v={{ site.buildTime }}"></script>
<script>
  (function () {
    const filterBtns = document.querySelectorAll("[data-karya-filter]");
    const cards = document.querySelectorAll("[data-karya-card]");
    if (!filterBtns.length || !cards.length) return;

    const MATCH_GROUPS = {
      elixir: ["elixir", "phoenix liveview", "otp"],
      ai: ["pi", "jev", "anthropic", "gemini api", "llm", "llm eval", "ai"],
      astro: ["astro", "typescript", "node.js"],
      "local-first": ["local-first", "sqlite", "turso"],
    };

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const group = btn.getAttribute("data-karya-filter") || "all";
        filterBtns.forEach((b) =>
          b.setAttribute("aria-pressed", b === btn ? "true" : "false"),
        );

        cards.forEach((card) => {
          if (group === "all") {
            card.hidden = false;
            return;
          }
          const rawTags = (card.getAttribute("data-tags") || "").split(",");
          const targets = MATCH_GROUPS[group] || [group];
          const matched = rawTags.some((t) => targets.includes(t.trim()));
          card.hidden = !matched;
        });
      });
    });
  })();
</script>
