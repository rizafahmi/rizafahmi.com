{# Isi satu halaman /tips/<slug>/.
   Datanya dari src/_data/tips.json lewat src/_data/tipsLibrary.js. #}
{% macro tipBody(tip, newerHref, olderHref) %}
  <p class="tip-breadcrumb"><a href="/tips/">Tips</a> / <span>{{ tip.durationLabel }}</span></p>

  <h2>{{ tip.title }}</h2>

  <div class="tip-meta">
    {%- if tip.publishedAt %}
    <span>📅 {{ tip.publishedAt | dateToISO }}</span>
    {%- endif %}
    {%- if tip.durationLabel %}
    <span>⏱️ {{ tip.durationLabel }}</span>
    {%- endif %}
  </div>

  {#- Click-to-play facade, not an eager <iframe>. The embed pulled ~1.3MB of
      YouTube player into a 46KB page and pushed the load event out to 10.3s.
      This ships the poster frame and swaps in the real player on first click —
      one extra tap before playback, which the video then starts by itself.

      It is a real <button> so it is focusable, keyboard-operable, and picks up
      the site's button:focus-visible ring. Without JS the button does nothing,
      so the "Tonton di YouTube" link below stays the no-JS path. -#}
  <div class="tip-player">
    <button
      type="button"
      class="tip-facade"
      aria-label="Putar video: {{ tip.title }}"
      data-tip-embed="{{ tip.embedUrl }}"
      data-tip-title="{{ tip.title }}">
      {#- posterThumbnail is the same frame as tip.thumbnail in WebP: identical
          pixels, roughly 60% fewer bytes. -#}
      <img src="{{ tip.posterThumbnail.url }}" alt="" width="{{ tip.posterThumbnail.width }}" height="{{ tip.posterThumbnail.height }}" fetchpriority="high" decoding="async" />
      <span class="tip-facade-play" aria-hidden="true"></span>
    </button>
  </div>

  {%- if tip.description %}
  <div class="tip-description">
    {%- for paragraph in tip.description.split("\n\n") %}
    <p>{{ paragraph }}</p>
    {%- endfor %}
  </div>
  {%- endif %}

  {%- if tip.tags.length %}
  <div class="article-topics" aria-label="Tag tips">
    {%- for tag in tip.tags %}
    <a href="/tips/topik/{{ tag.slug | url }}/">{{ tag.label }}</a>
    {%- endfor %}
  </div>
  {%- endif %}

  <p class="tip-watch">
    <a class="button" href="{{ tip.watchUrl }}" target="_blank" rel="noopener noreferrer">Tonton di YouTube &rarr;</a>
  </p>

  {#- Transkrip itu opsional dan diisi tangan di src/_data/tips.json.
      Kalau belum ada, halaman tidak menampilkan apa pun soal transkrip. #}
  {%- if tip.transcript %}
  <section class="tip-transcript">
    <h3>Transkrip</h3>
    {%- for paragraph in tip.transcript.split("\n\n") %}
    <p>{{ paragraph }}</p>
    {%- endfor %}
  </section>
  {%- endif %}

  {%- if newerHref or olderHref %}
  <nav class="tip-nav" aria-label="Tips lainnya">
    {%- if newerHref %}
    <a href="{{ newerHref }}">&larr; Tips lebih baru</a>
    {%- else %}
    <span></span>
    {%- endif %}
    {%- if olderHref %}
    <a href="{{ olderHref }}">Tips lebih lama &rarr;</a>
    {%- endif %}
  </nav>
  {%- endif %}
{% endmacro %}
