{# Utterances (GitHub-issue comments). Comments always sit at the very bottom of a
   page, so nothing here belongs on the critical path: the old code injected
   client.js during parse, which pulled an iframe, a stylesheet and an api.github.com
   search before the article heading had even painted. Lighthouse attributed ~600ms of
   LCP render delay on /now/ to it.

   Mounted on intersection instead, so it costs nothing until the reader scrolls to it.
   tulisan.njk and serial.njk both include this; they used to carry separate copies
   that had already drifted (serial.njk was pinned to the light theme). #}
<div id="utterances-container"></div>
<script>
  (function () {
    var mount = document.getElementById('utterances-container');
    if (!mount) return;

    var load = function () {
      var theme = document.documentElement.getAttribute('data-theme') === 'dark'
        ? 'github-dark'
        : 'github-light';
      var s = document.createElement('script');
      s.src = 'https://utteranc.es/client.js';
      s.setAttribute('repo', 'rizafahmi/rizafahmi.com');
      s.setAttribute('issue-term', 'pathname');
      s.setAttribute('label', '💬 Comment');
      s.setAttribute('theme', theme);
      s.setAttribute('crossorigin', 'anonymous');
      s.async = true;
      mount.appendChild(s);
    };

    if (!('IntersectionObserver' in window)) return load();

    var io = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          io.disconnect();
          load();
          return;
        }
      }
    }, { rootMargin: '600px' });

    io.observe(mount);
  })();
</script>
