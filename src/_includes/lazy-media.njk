{# Third-party widgets and heavy media, all gated on IntersectionObserver.

   Everything here sits below the fold by definition, so none of it belongs on the
   critical path -- and on this site the critical path is the whole LCP budget (see
   Performance in AGENTS.md). Included at the end of <body> by main.njk, tulisan.njk,
   serial.njk and cv.njk, so the DOM is already parsed. #}
<script>
  /* One observer factory for both loaders below: run `onEnter` the first time any of
     `nodes` comes within `margin` of the viewport, then stop watching. Falls back to
     loading immediately where IntersectionObserver is missing. */
  window.__lazyWhenNear = function (nodes, margin, onEnter) {
    if (!nodes.length) return;
    if (!('IntersectionObserver' in window)) return onEnter();
    var io = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          io.disconnect();
          onEnter();
          return;
        }
      }
    }, { rootMargin: margin });
    for (var i = 0; i < nodes.length; i++) io.observe(nodes[i]);
  };
</script>
<script>
  /* Twitter's widgets.js used to load unconditionally on every page. It is 27KB and
     pulls a ~103KB widget iframe behind it, yet only 3 of ~300 pages embed a tweet --
     on every other page it was pure critical-path cost. */
  (function () {
    var tweets = document.querySelectorAll('.twitter-tweet');
    window.__lazyWhenNear(tweets, '400px', function () {
      var s = document.createElement('script');
      s.src = 'https://platform.twitter.com/widgets.js';
      s.charset = 'utf-8';
      s.async = true;
      document.body.appendChild(s);
    });
  })();
</script>
<script>
  /* Autoplaying demo clips. An `autoplay` <video> must download before it can play, so
     the browser fetches it during load no matter what `preload` says -- one 100KB clip
     in an article pushed that page's LCP to 2.25s against 1.58s for its siblings. The
     lazyVideo transform in eleventy.config.js rewrites `autoplay` to `data-autoplay`
     and pins `preload="none"`; this starts playback once the clip is nearly on screen,
     which is the only moment an autoplaying decorative loop is worth any bytes. */
  (function () {
    var videos = document.querySelectorAll('video[data-autoplay]');
    for (var i = 0; i < videos.length; i++) {
      (function (video) {
        window.__lazyWhenNear([video], '200px', function () {
          video.preload = 'auto';
          video.autoplay = true;
          var started = video.play();
          // Autoplay can still be refused (a clip that lost its `muted`, or a
          // reduced-data setting). Leave the element alone rather than throwing.
          if (started && started.catch) started.catch(function () {});
        });
      })(videos[i]);
    }
  })();
</script>
