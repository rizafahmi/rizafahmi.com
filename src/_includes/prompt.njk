---
layout: main
pageCss: prompts.css
---

{% set neighbors = collections.prompts | promptNeighbors(page.url) %}
{% set rawSlug = slug or page.fileSlug %}
{% set vars = promptVariables or (prompt | extractPromptVariables(variables, rawSlug)) %}
{% set currentPromptItem = null %}
{% for pItem in collections.prompts %}
  {% if pItem.slug == rawSlug %}
    {% set currentPromptItem = pItem %}
  {% endif %}
{% endfor %}

<main id="main-content" class="container prompt-page" data-pagefind-body data-pagefind-meta="title:{{ title }}">
  <p class="prompt-breadcrumb">
    <a href="/prompts/">Prompt</a> / <a href="/prompts/#{{ category }}">{{ categoryLabel }}</a>
  </p>

  <h2>{{ (displayTitle or title) | safe }}</h2>

  <div class="prompt-detail-meta">
    <span class="prompt-badge prompt-badge--category">{{ categoryShortLabel }}</span>
    {%- if status %}
    <span class="prompt-badge">{{ status }}</span>
    {%- endif %}
    {%- if attribution %}
    <span class="prompt-meta-item">{{ attribution }}</span>
    {%- endif %}
    {%- if sourceUrl %}
    <a class="prompt-source-link" href="{{ sourceUrl }}" target="_blank" rel="noopener noreferrer">{{ sourceLabel or "Sumber asli" }} &nearr;</a>
    {%- endif %}
  </div>

  <p class="prompt-detail-summary">{{ description }}</p>

  {%- if prompt %}
  <section class="prompt-workbench" aria-labelledby="prompt-workbench-heading" data-prompt-workbench>
    <div class="prompt-workbench-bar">
      <span id="prompt-workbench-heading" class="prompt-workbench-label">⚡ EXECUTABLE WORKBENCH</span>
      <div class="prompt-workbench-actions">
        <a class="prompt-raw-link" href="/skills/{{ rawSlug }}/SKILL.md" title="Unduh sebagai Agent Skill (SKILL.md)">📦 SKILL.md</a>
        <a class="prompt-raw-link" href="/prompts/{{ rawSlug }}.md" title="Buka versi Markdown mentah untuk AI agent atau CLI">📄 .md</a>
        <button
          type="button"
          class="prompt-copy-btn"
          data-copy-target="prompt-primary-code"
          data-copy-label="Salin Prompt">
          Salin Prompt
        </button>
      </div>
    </div>

    {%- if vars and vars.length %}
    <div class="prompt-var-panel" data-prompt-var-panel>
      <div class="prompt-var-header">
        <span class="prompt-var-title">🎛️ ISI PARAMETER (&lt; 30 DETIK — LANGSUNG MEMPERBARUI PROMPT DI BAWAH)</span>
        <button type="button" class="prompt-var-reset" data-prompt-var-reset hidden>Reset Variabel</button>
      </div>
      <div class="prompt-var-grid">
        {%- for v in vars %}
        <div class="prompt-var-field">
          <label class="prompt-var-label" for="prompt-var-{{ loop.index }}">
            {{ v.label }} <code>{{ v.token }}</code>
          </label>
          <input
            id="prompt-var-{{ loop.index }}"
            class="prompt-var-input"
            type="text"
            placeholder="{{ v.placeholder }}"
            autocomplete="off"
            data-prompt-var="{{ v.token | escape }}"
          />
        </div>
        {%- endfor %}
      </div>
    </div>
    {%- endif %}

    <pre class="prompt-workbench-pre"><code id="prompt-primary-code" data-prompt-template="{{ prompt | trim | escape }}">{{ prompt | trim }}</code></pre>
    <p class="prompt-copy-status" role="status" aria-live="polite"></p>

    <div class="prompt-agent-pull">
      <div class="prompt-agent-pull-header">
        <span class="prompt-agent-pull-label">🤖 TARIK LANGSUNG KE AI AGENT (.AGENTS/SKILLS)</span>
        <button
          type="button"
          class="prompt-card-copy"
          data-copy-text="mkdir -p .agents/skills/{{ rawSlug }} && curl -fsSL https://rizafahmi.com/skills/{{ rawSlug }}/SKILL.md -o .agents/skills/{{ rawSlug }}/SKILL.md">
          Salin CLI Skill
        </button>
      </div>
      <code class="prompt-agent-pull-cmd">mkdir -p .agents/skills/{{ rawSlug }} &amp;&amp; curl -fsSL https://rizafahmi.com/skills/{{ rawSlug }}/SKILL.md -o .agents/skills/{{ rawSlug }}/SKILL.md</code>
    </div>
  </section>
  {%- endif %}

  <div class="prompt-detail-body">
    {{ content | safe }}
  </div>

  {%- if relatedArticle or (currentPromptItem and currentPromptItem.relatedKarya) %}
  <aside class="prompt-related-article" aria-label="Artikel dan bukti karya terkait">
    {%- if relatedArticle %}
    <div class="prompt-related-block">
      <span class="prompt-related-label">📚 PEMBAHASAN LENGKAP</span>
      <p>
        Prompt ini dibahas secara mendalam beserta contoh alur kerjanya di catatan:
        <a href="{{ relatedArticle }}">{{ relatedArticleTitle or relatedArticle }} &rarr;</a>
      </p>
    </div>
    {%- endif %}
    {%- if currentPromptItem and currentPromptItem.relatedKarya and currentPromptItem.relatedKaryaUrl %}
    <div class="prompt-related-block">
      <span class="prompt-related-label">🛠️ BUKTI KARYA (OPEN SOURCE PROOF-OF-WORK)</span>
      <p>
        Lihat implementasi nyata pola kerja ini di repositori:
        <a href="{{ currentPromptItem.relatedKaryaUrl }}" target="_blank" rel="noopener noreferrer">{{ currentPromptItem.relatedKarya }} &nearr;</a>
        &middot; <a href="/showcase/">Lihat di Galeri Karya &rarr;</a>
      </p>
    </div>
    {%- endif %}
  </aside>
  {%- endif %}

  {%- set promptTags = [category] -%}
  {%- if keywords -%}
    {%- for kw in keywords -%}
      {%- set promptTags = (promptTags.push(kw), promptTags) -%}
    {%- endfor -%}
  {%- endif -%}
  {%- set promptContext = { url: page.url, excludeUrl: relatedArticle, tags: promptTags, title: title, description: description, content: (prompt or "") + " " + (content or ""), onlyRelevant: true } -%}
  {%- set relArticles = collections.catatan | relatedArticles(promptContext, 2) -%}
  {%- set relTips = tipsLibrary.items | relatedTips(promptContext, 2) -%}
  {%- set relProjects = karya | karyaProjects | relatedProjects(promptContext, 2) -%}
  {%- if relArticles.length or relTips.length or relProjects.length %}
  <section class="cross-format-related" aria-label="Eksplorasi lintas format">
    <div class="cross-format-heading">🔗 EKSPLORASI LINTAS FORMAT</div>
    <div class="cross-format-grid">
      {%- for article in relArticles %}
      <a href="{{ article.url }}" class="cross-format-card">
        <span class="cross-format-badge">Catatan</span>
        <span class="cross-format-title">{{ article.data.title }}</span>
        <span class="cross-format-meta">{{ article.content | readingTime }} &rarr;</span>
      </a>
      {%- endfor %}
      {%- for tip in relTips %}
      <a href="{{ tip.url }}" class="cross-format-card">
        <span class="cross-format-badge">Tips{% if tip.durationLabel %} · {{ tip.durationLabel }}{% endif %}</span>
        <span class="cross-format-title">{{ tip.title }}</span>
        <span class="cross-format-meta">Video pendek &rarr;</span>
      </a>
      {%- endfor %}
      {%- for proj in relProjects %}
      <a href="{{ proj.url or proj.repo }}" target="_blank" rel="noopener noreferrer" class="cross-format-card">
        <span class="cross-format-badge">Karya · {{ proj.tags | head(2) | join(" / ") }}</span>
        <span class="cross-format-title">{{ proj.name }}</span>
        <span class="cross-format-meta">{{ proj.description }}</span>
      </a>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  <p class="prompt-disclaimer">
    Prompt dapat menghasilkan keluaran berbeda antar model, versi, dan konteks proyek. Periksa hasilnya sebelum menggunakan atau membagikannya.
  </p>

  {%- if neighbors.previous or neighbors.next %}
  <nav class="prompt-nav" aria-label="Prompt lainnya">
    {%- if neighbors.previous %}
    <a href="{{ neighbors.previous.url }}">&larr; {{ neighbors.previous.title }}</a>
    {%- else %}
    <span></span>
    {%- endif %}
    {%- if neighbors.next %}
    <a href="{{ neighbors.next.url }}">{{ neighbors.next.title }} &rarr;</a>
    {%- endif %}
  </nav>
  {%- endif %}

  <a class="back" href="/prompts/">&lt; SEMUA PROMPT</a>
</main>

<script type="module" src="/assets/prompts.js?v={{ site.buildTime }}"></script>
