---
title: Judul
---
<!DOCTYPE html>
<html lang="id">
  <head>
    <title>{{ title }} - Halo, Saya Riza!</title>
    {% include 'fonts.njk' %}
    <link rel="preload" as="style" href="/assets/global.css?v={{ site.buildTime }}" type="text/css" />
    <link rel="stylesheet" href="/assets/global.css?v={{ site.buildTime }}" type="text/css">
    <link rel="preload" as="style" href="/assets/tulisan.css?v={{ site.buildTime }}" type="text/css" />
    <link rel="stylesheet" href="/assets/tulisan.css?v={{ site.buildTime }}" type="text/css">
    {%- set ogType = "article" -%}
    {% include 'head.njk' %}
    {%- set isPublishedArticle = tags and 'catatan' in tags and date and not eleventyExcludeFromCollections -%}
    {%- set publishedDate = date or created -%}
    {%- set updatedDate = modified or date or created -%}
    <meta property="article:published_time" content="{{ publishedDate | dateToISOString }}" />
    {%- if modified %}
    <meta property="article:modified_time" content="{{ updatedDate | dateToISOString }}" />
    {%- endif %}
    <meta property="article:author" content="Riza Fahmi" />
    {%- if isPublishedArticle %}
      {%- for tag in tags %}
        {%- if tag and tag != 'catatan' and tag != 'all' and tag != 'post' and tag != 'nav' %}
    <meta property="article:tag" content="{{ tag | escape }}" />
        {%- endif %}
      {%- endfor %}
    {%- endif %}

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | jsonify | safe }},
      "description": {{ (description or (content | excerpt(220)) or title) | jsonify | safe }},
      "image": {{ _ogImageUrl | jsonify | safe }},
      "inLanguage": "id-ID",
      "author": {
        "@type": "Person",
        "name": {{ site.author.name | jsonify | safe }},
        "url": {{ site.author.url | jsonify | safe }}
      },
      "datePublished": {{ (publishedDate | dateToISOString) | jsonify | safe }},
      "dateModified": {{ (updatedDate | dateToISOString) | jsonify | safe }},
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ ("https://rizafahmi.com" + page.url) | jsonify | safe }}
      },
      "publisher": {
        "@type": "Person",
        "name": {{ site.author.name | jsonify | safe }}
      },
      "isPartOf": {
        "@type": "Blog",
        "name": {{ site.title | jsonify | safe }},
        "url": {{ site.url | jsonify | safe }}
      }
    }
    </script>
  </head>
  <body>
    <div class="reading-progress" id="reading-progress"></div>
    <a href="#main-content" class="skip-link">Langsung ke konten utama</a>
    <nav class="container" style="display: flex; justify-content: space-between; align-items: center;">
      <ol class="breadcrumb" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/"><span itemprop="name">Beranda</span></a>
          <meta itemprop="position" content="1" />
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/articles/"><span itemprop="name">Catatan</span></a>
          <meta itemprop="position" content="2" />
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
          <span itemprop="name">{{ title }}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode" style="background:none; border:none; cursor:pointer; font-size:1.5rem;">🌙</button>
    </nav>

    <main class="container" id="main-content">
      <article data-pagefind-body>
      {%- set canonicalUrl = "https://rizafahmi.com" + page.url -%}
      {%- set xShareHref = "https://twitter.com/intent/tweet?text=" + (title | urlencode) + "&url=" + (canonicalUrl | urlencode) -%}
      {%- set liShareHref = "https://www.linkedin.com/shareArticle?mini=true&url=" + (canonicalUrl | urlencode) + "&title=" + (title | urlencode) + "&summary=" + ((description or title) | urlencode) -%}

      <h1>{{ title }}</h1>
      <div class="article-meta">
        {%- if created -%}
        <small>🌱 Dibuat <time datetime="{{ created | dateToISO }}">{{ created | readableDate }}</time>.</small>
        {%- endif -%}
        {%- if modified -%}
        <small class="note-modified">🪴 Diperbarui <time datetime="{{ modified | dateToISO }}">{{ modified | readableDate }}</time>.</small>
        {%- endif -%}
        <small class="reading-time">⏱️ {{ content | readingTime }}</small>
        {%- if goatcounterViews and goatcounterViews[page.url] %}
        <small class="view-count" aria-label="Popularitas artikel">🔥 {{ goatcounterViews[page.url] | localeString }} dibaca</small>
        {%- endif %}
        <small class="share-links" aria-label="Bagikan">
          <button
            type="button"
            class="share-native"
            data-share-native
            data-share-title="{{ title | escape }}"
            data-share-url="{{ canonicalUrl }}"
            hidden>
            🔗 Bagikan bila bermanfaat
          </button>

          <span class="share-fallback" data-share-fallback>
            🔗 Bagikan bila bermanfaat:
            <a class="share-link" href="{{ xShareHref }}" target="_blank" rel="noopener noreferrer" aria-label="Bagikan ke X">X</a>
            <a class="share-link" href="{{ liShareHref }}" target="_blank" rel="noopener noreferrer" aria-label="Bagikan ke LinkedIn">LinkedIn</a>
            <button type="button" class="share-link share-copy" data-share-copy data-share-url="{{ canonicalUrl }}" aria-label="Salin link">📋 Salin</button>
          </span>
        </small>

        {%- if isPublishedArticle %}
          {%- set _tags = tags %}
          {%- if _tags is string %}{% set _tags = [_tags] %}{% endif %}
          {%- set visibleTags = [] %}
          {%- for t in _tags %}
            {%- if t and t != 'catatan' and t != 'all' and t != 'post' and t != 'nav' %}
              {%- set visibleTags = (visibleTags.push(t), visibleTags) %}
            {%- endif %}
          {%- endfor %}

          {%- if visibleTags.length %}
            <small class="note-tags">🏷️ Topik:
              {%- for t in visibleTags %}
                <a href="/tags/{{ t | url }}/">{{ t }}</a>{% if not loop.last %}, {% endif %}
              {%- endfor %}
            </small>
          {%- endif %}
        {%- endif %}
      </div>
      <small class="note-edit"> <a href="https://github.com/rizafahmi/rizafahmi.com/blob/main/{{ page.inputPath }}"><span role="img" aria-label="edit">✏️</span> Edit {{ editLabel or "catatan" }} ini.</a></small>
      <div class="note-edit">
      </div>

      {{ content | safe }}

      {%- if series and series_index %}
      {{ collections.catatan | seriesNav(series, series_index, page.url) | safe }}
      {%- endif %}

      {%- set neighbors = collections.catatan | articleNeighbors(page.url) %}
      {%- if neighbors.newer or neighbors.older %}
      <nav class="article-next" aria-label="Lanjut membaca">
        <h3>LANJUT MEMBACA</h3>
        <div class="article-next-grid">
          {%- if neighbors.older %}
          <a href="{{ neighbors.older.url }}" class="article-next-card">
            <span class="article-next-label">Sebelumnya</span>
            <strong>{{ neighbors.older.data.title }}</strong>
            <span>{{ neighbors.older.content | readingTime }}</span>
          </a>
          {%- endif %}
          {%- if neighbors.newer %}
          <a href="{{ neighbors.newer.url }}" class="article-next-card">
            <span class="article-next-label">Lebih baru</span>
            <strong>{{ neighbors.newer.data.title }}</strong>
            <span>{{ neighbors.newer.content | readingTime }}</span>
          </a>
          {%- endif %}
        </div>
      </nav>
      {%- endif %}

      {%- if isPublishedArticle %}
      <section class="related-articles">
        <h3>📚 Artikel Terkait</h3>
        <div class="related-grid">
          {%- set related = collections.catatan | relatedArticles({ url: page.url, tags: visibleTags, title: title, content: content }, 3) %}
          {%- for article in related %}
            <a href="{{ article.url }}" class="related-card">
              <span class="related-title">{{ article.data.title }}</span>
            </a>
          {%- endfor %}
        </div>
      </section>
      {%- endif %}

      <section class="follow-cta" aria-label="Ikuti saya">
        <div class="follow-cta-title">📢 IKUTI SAYA</div>
        <p>Jika kamu suka tulisan ini, mari terhubung untuk obrolan seputar pemrograman, Elixir, dan AI:</p>
        <div class="follow-cta-links">
          <a href="https://x.com/rizafahmi22" target="_blank" rel="noopener noreferrer" class="follow-btn">X / Twitter</a>
          <a href="https://linkedin.com/in/rizafahmi" target="_blank" rel="noopener noreferrer" class="follow-btn">LinkedIn</a>
        </div>
      </section>

      <hr />

      {%- set show_comments = false %}
      {%- if isPublishedArticle %}{% set show_comments = true %}{%- endif %}
      {%- if page.url == '/now/' %}{% set show_comments = true %}{%- endif %}
      {%- if page.url == '/uses/' %}{% set show_comments = true %}{%- endif %}

      {%- if show_comments %}
      <div id="utterances-container"></div>
      <script>
        (function() {
          var theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'github-dark' : 'github-light';
          var script = document.createElement('script');
          script.src = 'https://utteranc.es/client.js';
          script.setAttribute('repo', 'rizafahmi/rizafahmi.com');
          script.setAttribute('issue-term', 'pathname');
          script.setAttribute('label', '💬 Comment');
          script.setAttribute('theme', theme);
          script.setAttribute('crossorigin', 'anonymous');
          script.async = true;
          document.getElementById('utterances-container').appendChild(script);
        })();
      </script>
      {%- endif %}
      </article>
    </main>

    <footer class="container">

      <script>
        (function () {
          const btn = document.querySelector('[data-share-native]');
          const fallback = document.querySelector('[data-share-fallback]');
          const copyBtn = document.querySelector('[data-share-copy]');

          if (!btn || !fallback) return;

          // Native share (mostly mobile + some desktop Safari)
          if (navigator && typeof navigator.share === 'function') {
            btn.hidden = false;
            fallback.hidden = true;

            btn.addEventListener('click', async function () {
              const title = btn.getAttribute('data-share-title') || document.title;
              const url = btn.getAttribute('data-share-url') || window.location.href;
              const text = `${title} ${url}`;

              try {
                await navigator.share({ title, text, url });
              } catch (e) {
                // User cancelled or share failed; ignore.
              }
            });
          } else {
            btn.hidden = true;
            fallback.hidden = false;
          }

          // Clipboard fallback (nice for desktop)
          if (copyBtn && navigator && navigator.clipboard && navigator.clipboard.writeText) {
            copyBtn.addEventListener('click', async function () {
              const url = copyBtn.getAttribute('data-share-url') || window.location.href;
              try {
                await navigator.clipboard.writeText(url);
                const old = copyBtn.textContent;
                copyBtn.textContent = '✅ Tersalin';
                setTimeout(() => (copyBtn.textContent = old), 1200);
              } catch (e) {
                // ignore
              }
            });
          }
        })();
      </script>

    </footer>
    <script>
      (function() {
        var progressBar = document.getElementById('reading-progress');
        if (progressBar) {
          var ticking = false;
          window.addEventListener('scroll', function() {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(function() {
                var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
                var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                var scrolled = (winScroll / height) * 100;
                progressBar.style.width = scrolled + '%';
                ticking = false;
              });
            }
          });
        }
      })();
    </script>
    <script>
      document.querySelectorAll('.code-copy').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var block = btn.closest('.code-block');
          var code = block.querySelector('code');
          var text = Array.from(code.querySelectorAll('.line')).map(function (line) {
            return Array.from(line.childNodes).filter(function (node) {
              return !node.classList || !node.classList.contains('line-prefix');
            }).map(function (node) { return node.textContent; }).join('');
          }).join('\n').replace(/\n+$/, '');
          navigator.clipboard.writeText(text).then(function () {
            btn.textContent = '✅ Tersalin';
            setTimeout(function () { btn.textContent = 'Salin'; }, 1200);
          });
        });
      });
    </script>
    <script>
      (function() {
        var url = window.location.pathname;
        if (!url) return;

        // Restore scroll position on load
        var saved = localStorage.getItem('scrollPos:' + url);
        if (saved) {
          var pos = parseInt(saved, 10);
          if (pos > 0) {
            setTimeout(function() { window.scrollTo(0, pos); }, 50);
          }
        }

        // Debounced scroll position save
        var scrollTimer;
        window.addEventListener('scroll', function() {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(function() {
            localStorage.setItem('scrollPos:' + url, window.scrollY);
          }, 300);
        }, { passive: true });

        // Mark article as completed when footer becomes visible
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var completed = JSON.parse(localStorage.getItem('completedArticles') || '[]');
              if (completed.indexOf(url) === -1) {
                completed.push(url);
                localStorage.setItem('completedArticles', JSON.stringify(completed));
              }
              observer.disconnect();
            }
          });
        }, { threshold: 0 });

        var footer = document.querySelector('footer.container');
        if (footer) observer.observe(footer);
      })();
    </script>
    {% include 'analytics.njk' %}
    {% include 'webvitals.njk' %}
    {% include 'keyboard-shortcuts.njk' %}
    {% include 'theme-toggle.njk' %}
  </body>
</html>
