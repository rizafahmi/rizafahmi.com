---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag | url }}/"
layout: main
eleventyComputed:
  title: "Topik: {{ tag }}"
---

<main class="container" id="main-content">
  <div class="articles-header">
    <h2>TOPIK: {{ tag | upper }}</h2>
    <div class="rss-pill">
      📄 {{ collections[tag] | length }} TULISAN
    </div>
  </div>

  <div class="articles">
    {%- for article in collections[tag] | reverse %}
      <article class="article">
        <div class="article-meta-row">
          <span>📅 {{ article.date | dateToISO }}</span>
          <span>⏱️ {{ article.content | readingTime }}</span>
        </div>
        <h3>
          <a href="{{article.url}}">{{ article.data.title }}</a>
        </h3>
      </article>
    {%- endfor %}
  </div>

  <a class="back" href="/tags/">&lt; SEMUA TOPIK</a>
</main>
