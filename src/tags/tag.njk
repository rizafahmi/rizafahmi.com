---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag | url }}/"
layout: main
eleventyComputed:
  title: "Topik: {{ tag }}"
  description: "Kumpulan tulisan Riza Fahmi tentang {{ tag }}. Jelajahi artikel, catatan, dan panduan praktis berdasarkan topik ini."
---

<main class="container" id="main-content">
  <div class="articles-header">
    <h2>TOPIK: {{ tag | upper }}</h2>
    <div class="rss-pill">
      📄 {{ collections[tag] | length }} TULISAN
    </div>
  </div>

  <p class="articles-intro">
    Arsip tulisan bertopik <strong>{{ tag }}</strong>. Baca dari artikel terbaru, atau kembali ke
    <a href="/topik/">topik pilihan</a> untuk jalur belajar yang lebih terkurasi.
  </p>

  <div class="articles">
    {%- for article in collections[tag] | reverse %}
      <article class="article">
        <div class="article-meta-row">
          <span>📅 {{ article.date | dateToISO }}</span>
          <span>⏱️ {{ article.content | readingTime }}</span>
        </div>
        <h3>
          <a href="{{article.url}}">{{ article.data.title }}</a>
        </h3>
        <p class="article-excerpt">
          {{ article.data.description or (article.templateContent | excerpt(180)) }}
        </p>
        {%- set visibleTags = article.data.tags | publicTags %}
        {%- if visibleTags.length %}
        <div class="article-topics" aria-label="Topik artikel">
          {%- for t in visibleTags | head(4) %}
          <a href="/tags/{{ t | url }}/">{{ t }}</a>
          {%- endfor %}
        </div>
        {%- endif %}
      </article>
    {%- endfor %}
  </div>

  <a class="back" href="/tags/">&lt; SEMUA TOPIK</a>
</main>
