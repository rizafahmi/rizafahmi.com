  {%- set hubContext = { url: page.url, tags: ["ai", "agentic-coding", "spesifikasi", "planning"], title: title, description: description } -%}
  {%- set hubPrompts = collections.prompts | relatedPrompts(hubContext, 4) -%}
  {%- set hubTips = tipsLibrary.items | relatedTips(hubContext, 4) -%}
  {%- set hubProjects = karya | karyaProjects | relatedProjects(hubContext, 4) -%}

  <section class="cross-format-related" aria-label="Prompt, Tips, dan Karya AI">
    <div class="cross-format-heading">🔗 PROMPT, TIPS &amp; KARYA TERKAIT</div>
    <div class="cross-format-grid">
      {%- for p in hubPrompts %}
      <a href="{{ p.url }}" class="cross-format-card">
        <span class="cross-format-badge">Prompt · {{ p.categoryShortLabel }}</span>
        <span class="cross-format-title">{{ p.title }}</span>
        <span class="cross-format-meta">{{ p.description | excerpt(80) }}</span>
      </a>
      {%- endfor %}
      {%- for tip in hubTips %}
      <a href="{{ tip.url }}" class="cross-format-card">
        <span class="cross-format-badge">Tips{% if tip.durationLabel %} · {{ tip.durationLabel }}{% endif %}</span>
        <span class="cross-format-title">{{ tip.title }}</span>
        <span class="cross-format-meta">Video pendek &rarr;</span>
      </a>
      {%- endfor %}
      {%- for proj in hubProjects %}
      <a href="{{ proj.url or proj.repo }}" target="_blank" rel="noopener noreferrer" class="cross-format-card">
        <span class="cross-format-badge">Karya · {{ proj.tags | head(2) | join(" / ") }}</span>
        <span class="cross-format-title">{{ proj.name }}</span>
        <span class="cross-format-meta">{{ proj.description }}</span>
      </a>
      {%- endfor %}
    </div>
  </section>

  <p style="font-size: 0.9rem; color: var(--meta-color);">
